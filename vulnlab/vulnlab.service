[Unit]
Description=VulnLab - 三态漏洞复测靶场（绑定 docker0 网关地址，仅内网可达）
# 依赖 docker0（172.17.0.1）存在：docker 启动前 bind 会失败，由 Restart=always 兜底重试
Wants=docker.service
After=network.target docker.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/vulnlab/vulnlab.py
Environment=VULNLAB_HOST=172.17.0.1
Environment=VULNLAB_PORT=8081
Environment=VULNLAB_LOG=/var/log/vulnlab.log
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
